# Copy to .env for local development. All values have safe defaults for dev.

# Secret used to sign JWTs. MUST be overridden in production (>= 32 bytes).
JWT_SECRET=dev-insecure-secret-change-me-in-production-please

# Minutes an access token stays valid.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SQLite file. Recreated from scratch on every startup.
# DB_PATH=./prelegal.db

# Directory holding the statically-exported frontend (Next.js `out/`).
# FRONTEND_DIST=./static

# OpenRouter API key for the NDA chat (LiteLLM -> OpenRouter -> Cerebras).
# Also read from the repo-root .env; required for the /api/chat endpoint.
OPENROUTER_API_KEY=
